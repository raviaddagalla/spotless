<?xml version="1.0" encoding="utf-8"?>
<!-- just_audio serves sources that carry HTTP headers (YouTube streams) via
     its own localhost proxy (http://127.0.0.1:<port>/...). Android blocks
     cleartext traffic by default, so allow it for the loopback host only. -->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
